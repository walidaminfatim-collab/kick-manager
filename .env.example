# ===== Backend =====
NODE_ENV=development
PORT=3000
# Public URL of the backend (no trailing slash). Production MUST be https.
BACKEND_URL=http://localhost:3000
# MongoDB Atlas connection string
MONGODB_URI=
# Random string, 48+ chars
JWT_SECRET=
# EXACTLY 64 hex chars (32 bytes) - encrypts OAuth tokens at rest
ENCRYPTION_KEY=
# Random string, 32+ chars - HMAC key for license-code hashes
LICENSE_HASH_SECRET=
# Random string, 32+ chars - shared secret between bot and backend
BOT_INTERNAL_SECRET=
# Chrome extension ID (shown at chrome://extensions after "Load unpacked")
EXTENSION_ID=
# Optional: extra comma-separated CORS origins
CORS_ORIGINS=

# ===== Kick OAuth (https://kick.com -> Settings -> Developer) =====
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Must equal BACKEND_URL + /api/kick/oauth/callback and be registered in your Kick app
KICK_REDIRECT_URI=http://localhost:3000/api/kick/oauth/callback

# ===== Discord bot =====
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Guild where slash commands are registered
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to use /license
ADMIN_IDS=
